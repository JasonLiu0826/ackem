{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["electron.vite.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/main/extensions", "**/*.test.*", "**/*.spec.*", "**/__tests__/**", "**/__fixtures__/**", "src/main/engine/seed-test-data.ts", "src/main/engine/test-harness.ts", "src/main/memory/testCleanup.ts", "src/main/desktop-agent/routing/resolveCapability.testutil.ts"]
}
